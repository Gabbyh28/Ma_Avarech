{
  "name": "ma-avarech",
  "version": "1.0.0",
  "description": "מה אברך – ברכה ראשונה ואחרונה לכל מאכל",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "build": "node scripts/build-single.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:www": "node scripts/build-www.mjs",
    "android:sync": "npm run build:www && npx cap sync android",
    "android:icons": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
